datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  MANAGER
}

enum GenderAllowed {
  MALE
  FEMALE
  ANY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  role          Role             @default(STUDENT)
  accounts      Account[]
  sessions      Session[]
  hostels       Hostel[]         @relation("ManagerHostels")
  bookings      BookingRequest[] @relation("StudentBookings")
  createdAt     DateTime         @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Hostel {
  id            String           @id @default(cuid())
  name          String
  city          String
  address       String
  dailyPrice    Int
  monthlyPrice  Int
  availableBeds Int
  gender        GenderAllowed    @default(ANY)
  managerId     String
  manager       User             @relation("ManagerHostels", fields: [managerId], references: [id], onDelete: Cascade)
  bookings      BookingRequest[]
  createdAt     DateTime         @default(now())
}

model BookingRequest {
  id        String        @id @default(cuid())
  stayType  String        @default("DAILY")
  status    BookingStatus @default(PENDING)
  studentId String
  student   User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  hostelId  String
  hostel    Hostel        @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}