generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums based on your TypeScript types
enum PropertyType {
  HOSTEL
  PG
}

enum GenderAllowed {
  ANY
  MALE
  FEMALE
}

// Add the Role enum here
enum Role {
  STUDENT
  MANAGER
}

// 1. The User Model
model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  
  // Changed from String to Role Enum
  role            Role             @default(STUDENT) 
  createdAt       DateTime         @default(now())
  
  // Relations
  hostels         Hostel[]         
  bookingRequests BookingRequest[] 
}

// 2. The Hostel Model
model Hostel {
  id            String           @id @default(cuid())
  name          String
  type          PropertyType     @default(HOSTEL)
  gender        GenderAllowed    @default(ANY)
  city          String
  address       String
  dailyPrice    Int
  monthlyPrice  Int
  availableBeds Int
  
  // Relation to the User (Manager)
  managerId     String
  manager       User             @relation(fields: [managerId], references: [id])
  
  // Relation to Bookings
  bookingRequests BookingRequest[]
}

// 3. The Booking Request Model
model BookingRequest {
  id        String   @id @default(cuid())
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  // Relation to the User (Student)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  // Relation to the Hostel
  hostelId  String
  hostel    Hostel   @relation(fields: [hostelId], references: [id])
  
  createdAt DateTime @default(now())
}