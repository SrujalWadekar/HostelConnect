generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Enums
enum PropertyType {
  HOSTEL
  PG
}

enum GenderAllowed {
  ANY
  MALE
  FEMALE
}

enum Role {
  STUDENT
  MANAGER
}

// 2. The User Model
model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  role            Role             @default(STUDENT)
  createdAt       DateTime         @default(now())

  // Relations
  hostels         Hostel[]
  bookingRequests BookingRequest[]
  reviews         Review[]
}

// 3. The Hostel Model
model Hostel {
  id            String         @id @default(cuid())
  name          String
  type          PropertyType   @default(HOSTEL)
  gender        GenderAllowed  @default(ANY)
  city          String
  address       String
  dailyPrice    Int
  monthlyPrice  Int
  availableBeds Int

  // Relation to Manager
  managerId     String
  manager       User           @relation(fields: [managerId], references: [id])

  // Relations
  bookingRequests BookingRequest[]
  reviews         Review[]
}

// 4. The Booking Request Model
model BookingRequest {
  id        String   @id @default(cuid())
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED

  // Relation to Student
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // Relation to Hostel
  hostelId  String
  hostel    Hostel   @relation(fields: [hostelId], references: [id])

  createdAt DateTime @default(now())
}

// 5. The Review Model
model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1 to 5
  comment   String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  hostelId  String
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}